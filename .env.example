# Required for the agent (the individual tools run without it)
ANTHROPIC_API_KEY=

# Optional: model override (default claude-opus-5-5). claude-sonnet-5-5 / claude-haiku-5-5 are cheaper.
SCAMCHECK_MODEL=claude-opus-5-5

# Optional: enables the Google Safe Browsing check in check_domain. Without it the check reports "unverified".
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: claude | rules | auto (default auto: the Claude agent when ANTHROPIC_API_KEY is set, else the rules engine)
SCAMCHECK_ENGINE=auto

# Deployment (see docs/deploy.md)
# Serve the static web UI from this directory (the Docker image sets /app/static).
# SCAMCHECK_STATIC_DIR=web/out
# Behind a reverse proxy: trust X-Forwarded-For and count this many proxies from the right.
# SCAMCHECK_TRUST_PROXY=1
# SCAMCHECK_PROXY_HOPS=1
