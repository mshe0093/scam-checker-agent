{
  "_meta": {
    "description": "Self-written scam message templates paraphrasing patterns described in public Malaysian advisories and news reports. No advisory text is copied. Small, illustrative and NOT exhaustive.",
    "checked_on": "2026-11-06"
  },
  "patterns": [
    {"id": "bank-suspended-link", "category": "bank_phishing", "lang": "en",
     "template": "Your bank account has been suspended due to suspicious activity. Verify your details now at the link to avoid permanent lock.",
     "indicators": ["suspended", "verify", "suspicious activity", "permanent", "lock", "blocked", "login"],
     "source_url": "https://soyacincau.com/2024/04/12/malaysia-banks-never-request-personal-information-online-scam/"},
    {"id": "bank-suspended-link-bm", "category": "bank_phishing", "lang": "ms",
     "template": "Akaun bank anda telah disekat kerana aktiviti mencurigakan. Sila sahkan maklumat anda segera melalui pautan untuk mengelakkan akaun dibekukan.",
     "indicators": ["disekat", "digantung", "sahkan", "segera", "dibekukan", "pautan", "aktiviti mencurigakan"],
     "source_url": "https://soyacincau.com/2024/04/12/malaysia-banks-never-request-personal-information-online-scam/"},
    {"id": "bank-points-expiring", "category": "bank_phishing", "lang": "en",
     "template": "Your reward points will expire today. Redeem them now by logging in at the link before they are forfeited.",
     "indicators": ["points", "expire", "redeem", "today", "forfeited", "login"],
     "source_url": "https://soyacincau.com/2024/04/12/malaysia-banks-never-request-personal-information-online-scam/"},
    {"id": "bank-tac-request", "category": "bank_phishing", "lang": "en",
     "template": "We detected a transaction on your account. If this was not you, reply with the TAC code sent to your phone so we can cancel it.",
     "indicators": ["tac", "otp", "code", "cancel", "transaction", "reply"],
     "source_url": "https://maybank2u.com.my/maybank2u/malaysia/en/personal/security_alert/tac_fraud.page"},
    {"id": "parcel-held-fee", "category": "parcel_courier", "lang": "en",
     "template": "Your parcel is on hold at our warehouse due to an incomplete address. Pay a small redelivery fee at the link to reschedule delivery.",
     "indicators": ["parcel", "on hold", "address", "redelivery", "fee", "reschedule", "warehouse"],
     "source_url": "https://www.bernama.com/en/news.php?id=2572009"},
    {"id": "parcel-customs-duty", "category": "parcel_courier", "lang": "en",
     "template": "A package addressed to you has been held by customs. Pay the import duty within 24 hours or it will be returned to sender.",
     "indicators": ["package", "customs", "duty", "24 hours", "returned", "held"],
     "source_url": "https://www.bernama.com/en/news.php?id=2572009"},
    {"id": "parcel-held-bm", "category": "parcel_courier", "lang": "ms",
     "template": "Bungkusan anda tidak dapat dihantar kerana alamat tidak lengkap. Sila kemas kini alamat dan bayar caj penghantaran semula di pautan ini.",
     "indicators": ["bungkusan", "alamat", "kemas kini", "caj", "penghantaran semula", "pautan"],
     "source_url": "https://www.bernama.com/en/news.php?id=2572009"},
    {"id": "lhdn-tax-arrears", "category": "government_impersonation", "lang": "en",
     "template": "LHDN notice: you have outstanding tax arrears. Settle the amount within 72 hours to avoid legal action and a travel ban.",
     "indicators": ["lhdn", "tax", "arrears", "outstanding", "72 hours", "legal action", "travel ban"],
     "source_url": "https://www.malaymail.com/news/malaysia/2026/06/10/received-an-lhdn-email-demanding-action-in-72-hours-heres-how-to-spot-if-its-a-scam/223213"},
    {"id": "lhdn-refund", "category": "government_impersonation", "lang": "en",
     "template": "You are eligible for a tax refund. Submit your bank details at the link to receive your refund.",
     "indicators": ["tax refund", "eligible", "bank details", "receive", "refund"],
     "source_url": "https://www.hasil.gov.my/en/polisi-portal/peringatan-penipuan/"},
    {"id": "jpj-summons", "category": "government_impersonation", "lang": "en",
     "template": "JPJ: you have an unpaid traffic summons and your licence will be blacklisted. Pay now at the link to avoid blacklisting.",
     "indicators": ["jpj", "summons", "unpaid", "blacklist", "licence", "pay now"],
     "source_url": "https://www.motorist.my/article/6079/scam-alert-jpj-blacklist-sms-2026-don-t-click-that-link"},
    {"id": "jpj-saman-bm", "category": "government_impersonation", "lang": "ms",
     "template": "Anda mempunyai saman trafik tertunggak. Lesen anda akan disenarai hitam. Bayar segera di pautan berikut.",
     "indicators": ["saman", "tertunggak", "senarai hitam", "lesen", "bayar segera"],
     "source_url": "https://www.motorist.my/article/6079/scam-alert-jpj-blacklist-sms-2026-don-t-click-that-link"},
    {"id": "toll-unpaid-mybayar", "category": "government_impersonation", "lang": "en",
     "template": "You have unpaid toll charges. Pay through MyBayar at the link today to avoid a fine and a PDRM summons.",
     "indicators": ["toll", "unpaid", "mybayar", "fine", "pdrm", "summons"],
     "source_url": "https://www.thevibes.com/articles/news/117747/cops-warn-public-against-scams-using-pdrm-and-mybayar-names"},
    {"id": "police-case-safe-account", "category": "government_impersonation", "lang": "en",
     "template": "This is the police. Your identity card was used in a money laundering case. Transfer your savings to a safe account for investigation.",
     "indicators": ["police", "money laundering", "identity card", "ic", "safe account", "investigation", "transfer"],
     "source_url": "https://www.malaymail.com/news/malaysia/2026/01/25/phone-scam-syndicate-uses-caller-id-spoofing-to-impersonate-telcos-agencies-says-bukit-aman-commercial-crime-chief/206732"},
    {"id": "loan-approved-fee", "category": "loan_investment", "lang": "en",
     "template": "Congratulations, your personal loan of RM50,000 is approved with low interest and no documents needed. Pay a processing fee first to release the funds.",
     "indicators": ["loan", "approved", "low interest", "no documents", "processing fee", "release", "congratulations"],
     "source_url": "https://www.bnm.gov.my/-/update-on-financial-consumer-alert-list"},
    {"id": "loan-approved-bm", "category": "loan_investment", "lang": "ms",
     "template": "Tahniah, pinjaman peribadi anda telah diluluskan tanpa dokumen. Bayar yuran pemprosesan dahulu untuk pengeluaran wang.",
     "indicators": ["pinjaman", "diluluskan", "tanpa dokumen", "yuran", "pemprosesan", "tahniah"],
     "source_url": "https://www.bnm.gov.my/-/update-on-financial-consumer-alert-list"},
    {"id": "investment-guaranteed", "category": "loan_investment", "lang": "en",
     "template": "Join our investment group and earn guaranteed returns of 30% per week. Limited slots, invest today through our agent.",
     "indicators": ["investment", "guaranteed", "returns", "per week", "limited slots", "profit", "agent"],
     "source_url": "https://www.bnm.gov.my/-/update-on-financial-consumer-alert-list"},
    {"id": "job-task-like", "category": "job_task", "lang": "en",
     "template": "Part time job: earn RM300 a day by liking videos and completing simple tasks from home. Contact us on WhatsApp to start.",
     "indicators": ["part time", "earn", "per day", "a day", "tasks", "from home", "whatsapp", "commission"],
     "source_url": "https://www.thevibes.com/articles/news/116658/malaysia-hit-with-over-67000-online-crime-cases-in-11-months-losses-surpass-rm2.7-billion"},
    {"id": "job-task-bm", "category": "job_task", "lang": "ms",
     "template": "Kerja sambilan dari rumah, pendapatan RM200 sehari. Hanya perlu like dan follow. Hubungi kami di WhatsApp sekarang.",
     "indicators": ["kerja sambilan", "dari rumah", "sehari", "pendapatan", "whatsapp", "komisen"],
     "source_url": "https://www.thevibes.com/articles/news/116658/malaysia-hit-with-over-67000-online-crime-cases-in-11-months-losses-surpass-rm2.7-billion"},
    {"id": "prize-lucky-draw", "category": "prize", "lang": "en",
     "template": "Congratulations, you have won a cash prize in our lucky draw. Claim it now by paying the delivery and tax charges.",
     "indicators": ["congratulations", "won", "prize", "lucky draw", "claim", "charges"],
     "source_url": "https://www.thevibes.com/articles/news/116658/malaysia-hit-with-over-67000-online-crime-cases-in-11-months-losses-surpass-rm2.7-billion"},
    {"id": "family-new-number", "category": "impersonation", "lang": "en",
     "template": "Hi mum, this is my new number, my phone broke. Can you transfer some money urgently, I will pay you back tomorrow.",
     "indicators": ["new number", "phone broke", "mum", "dad", "urgent", "transfer", "pay you back"],
     "source_url": "https://www.thevibes.com/articles/news/116658/malaysia-hit-with-over-67000-online-crime-cases-in-11-months-losses-surpass-rm2.7-billion"},
    {"id": "ewallet-verify", "category": "bank_phishing", "lang": "en",
     "template": "Your eWallet account will be deactivated. Update your eKYC verification at the link within 24 hours to keep using it.",
     "indicators": ["ewallet", "deactivated", "ekyc", "verification", "24 hours", "update"],
     "source_url": "https://www.tngdigital.com.my/ms/report-suspicious-activities/"}
